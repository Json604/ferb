diff -ruN a/src/system_config/apple_mobile.rs b/src/system_config/apple_mobile.rs
--- a/src/system_config/apple_mobile.rs
+++ b/src/system_config/apple_mobile.rs
@@ -0,0 +1,91 @@
+//! System DNS configuration on iOS and the other Apple mobile platforms, through libresolv.
+//!
+//! The SystemConfiguration dynamic store the macOS reader uses is
+//! `API_UNAVAILABLE(ios, tvos, watchos)` in the SDK, so an app that imports it
+//! may be refused by App Store review. `res_ninit` and `res_getservers` from
+//! `<resolv.h>` are the public equivalent and return the resolver the system is
+//! using (the same approach as netdev 0.47's iOS reader). Search domains are not
+//! read: they live in `struct __res_state`, which is kept opaque here.
+
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV6};
+
+use super::{Config, DnsProtocol, Hosts, Nameserver};
+
+/// `struct __res_state` from `<resolv.h>`, kept opaque: 552 bytes, 8-aligned on
+/// 64-bit Apple targets (checked against the iOS 27.2 SDK).
+#[repr(C, align(8))]
+struct ResState([u8; 552]);
+
+/// `union res_sockaddr_union` from `<resolv.h>`: 128 bytes, 4-aligned.
+#[repr(C, align(4))]
+#[derive(Clone, Copy)]
+struct ResSockaddrUnion([u8; 128]);
+
+/// `MAXNS` from `<resolv.h>`.
+const MAXNS: usize = 3;
+
+#[link(name = "resolv")]
+unsafe extern "C" {
+    fn res_9_ninit(state: *mut ResState) -> libc::c_int;
+    fn res_9_getservers(
+        state: *mut ResState,
+        set: *mut ResSockaddrUnion,
+        cnt: libc::c_int,
+    ) -> libc::c_int;
+    fn res_9_ndestroy(state: *mut ResState);
+}
+
+/// Reads the system's nameservers from libresolv.
+///
+/// Also reads the hosts file.
+pub(super) fn read_system_dns() -> Result<Config, std::io::Error> {
+    let mut state = ResState([0; 552]);
+    let mut servers = [ResSockaddrUnion([0; 128]); MAXNS];
+    // SAFETY: `state` is zeroed and as large and aligned as `struct __res_state`,
+    // as `res_ninit` requires, and destroyed only after a successful init.
+    // `servers` holds `MAXNS` unions, the count passed.
+    let count = unsafe {
+        if res_9_ninit(&mut state) != 0 {
+            return Err(std::io::Error::other("res_ninit failed"));
+        }
+        let count = res_9_getservers(&mut state, servers.as_mut_ptr(), MAXNS as libc::c_int);
+        res_9_ndestroy(&mut state);
+        count
+    };
+    let nameservers = servers
+        .iter()
+        .take(usize::try_from(count).unwrap_or(0))
+        .filter_map(socket_addr)
+        .map(|ip| Nameserver::new(ip, DnsProtocol::Udp))
+        .collect();
+    Ok(Config {
+        nameservers,
+        search_domains: Vec::new(),
+        ndots: None,
+        hosts: Hosts::from_system(),
+    })
+}
+
+/// The nameserver's address on the DNS port, with an IPv6 address's scope (a
+/// link-local resolver such as `fe80::1` needs its interface).
+fn socket_addr(addr: &ResSockaddrUnion) -> Option<SocketAddr> {
+    let port = DnsProtocol::Udp.port();
+    // BSD `sockaddr`: `sa_len` then `sa_family`.
+    match i32::from(addr.0[1]) {
+        libc::AF_INET => {
+            // SAFETY: the union holds a `sockaddr_in` for `AF_INET` and is larger than it.
+            let sin: libc::sockaddr_in =
+                unsafe { std::ptr::read_unaligned(addr.0.as_ptr().cast()) };
+            let ip = Ipv4Addr::from(u32::from_be(sin.sin_addr.s_addr));
+            Some(SocketAddr::new(IpAddr::V4(ip), port))
+        }
+        libc::AF_INET6 => {
+            // SAFETY: the union holds a `sockaddr_in6` for `AF_INET6` and is larger than it.
+            let sin6: libc::sockaddr_in6 =
+                unsafe { std::ptr::read_unaligned(addr.0.as_ptr().cast()) };
+            let ip = Ipv6Addr::from(sin6.sin6_addr.s6_addr);
+            Some(SocketAddr::V6(SocketAddrV6::new(ip, port, 0, sin6.sin6_scope_id)))
+        }
+        _ => None,
+    }
+}
