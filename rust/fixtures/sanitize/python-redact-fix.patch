diff --git a/tests/test_redaction_rebuild.py b/tests/test_redaction_rebuild.py
index d1ef3132..4750e0c6 100644
--- a/tests/test_redaction_rebuild.py
+++ b/tests/test_redaction_rebuild.py
@@ -150,6 +150,29 @@ def test_a_secret_keys_structure_keeps_its_shape_with_every_value_masked() -> No
         {"credentials": {"user": REDACTED, "password": REDACTED, "otp": [REDACTED, None], "ok": True}}


+KEY_BEGIN, KEY_END = "-----BEGIN RSA " + "PRIVATE KEY-----", "-----END RSA " + "PRIVATE KEY-----"
+KEY_LINE = "QUJD" + fake(20)
+
+
+@pytest.mark.parametrize("between, expected", [
+    ({"data": KEY_LINE}, {"data": REDACTED}),
+    ({"text": "x", "data": KEY_LINE}, {"text": REDACTED, "data": REDACTED}),
+    ([KEY_LINE, ""], [REDACTED, ""]),
+    ({"data": {"deep": [KEY_LINE, {"more": KEY_LINE.encode()}], "n": 7, "f": 1.5, "ok": None}},
+     {"data": {"deep": [REDACTED, {"more": REDACTED}], "n": REDACTED, "f": 1.5, "ok": None}}),
+    (KEY_LINE.encode(), REDACTED),
+    (True, True),
+])
+def test_a_private_keys_lines_across_items_are_masked_whatever_holds_them(between, expected) -> None:
+    """Every text, number and byte string between a key's BEGIN and END items is masked, under any key and at any
+    depth; a boolean, None or a float cannot carry a key's lines and stays."""
+    r = Redactor()
+    assert r([KEY_BEGIN, between, KEY_END, "after"]) == [REDACTED, expected, REDACTED, "after"]
+    assert r({"a": KEY_BEGIN, "b": between, "c": KEY_END}) == {"a": REDACTED, "b": expected, "c": REDACTED}
+    nodes = [{"role": "text", "text": KEY_BEGIN}, {"role": "text", "text": KEY_LINE}, {"role": "text", "text": KEY_END}]
+    assert KEY_LINE not in json.dumps(r(nodes)) and "-----END" not in json.dumps(r(nodes))
+
