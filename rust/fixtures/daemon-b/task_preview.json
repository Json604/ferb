{
 "scenarios": [
  {
   "name": "never_queues_and_abandoned_frees",
   "what": "test_a_request_never_queues_behind_the_worker_and_an_abandoned_one_frees_the_surface",
   "limit_s": 2.0,
   "during_reads": true,
   "allowed": true,
   "surfaces": {
    "first": [
     {
      "frame": "first"
     }
    ],
    "stuck": [
     {
      "gate": "g",
      "frame": "late"
     }
    ]
   },
   "steps": [
    {
     "do": "declare",
     "root": "t",
     "worker": "t.worker",
     "target": {
      "scope": "app:Notes",
      "label": "Notes",
      "surface": "first"
     },
     "locks": [
      "app:com.apple.Notes"
     ]
    },
    {
     "do": "frame",
     "root": "t"
    },
    {
     "do": "hold",
     "id": "w",
     "keys": [
      "app:com.apple.Notes"
     ]
    },
    {
     "do": "frame",
     "root": "t"
    },
    {
     "do": "unhold",
     "id": "w"
    },
    {
     "do": "declare",
     "root": "t",
     "worker": "t.worker",
     "target": {
      "scope": "app:Notes",
      "label": "Notes",
      "surface": "stuck"
     },
     "locks": [
      "app:com.apple.Notes"
     ]
    },
    {
     "do": "frame_bg",
     "id": "r",
     "root": "t"
    },
    {
     "do": "wait_entered",
     "gate": "g"
    },
    {
     "do": "free",
     "keys": [
      "app:com.apple.Notes"
     ]
    },
    {
     "do": "cancel",
     "id": "r"
    },
    {
     "do": "free",
     "keys": [
      "app:com.apple.Notes"
     ]
    },
    {
     "do": "snapshot"
    }
   ],
   "results": [
    null,
    {
     "state": "working",
     "line": "Working in Notes",
     "worker": "t.worker",
     "step": "worker",
     "image": "first",
     "fresh": true,
     "seq": 1,
     "age_ms": 0
    },
    null,
    {
     "state": "working",
     "line": "Working in Notes",
     "worker": "t.worker",
     "step": "worker",
     "image": "first",
     "fresh": false,
     "seq": 1,
     "age_ms": 0,
     "busy": true
    },
    null,
    null,
    null,
    null,
    false,
    "cancelled",
    true,
    {
     "requests": 3,
     "frames": 1,
     "capture_ms": 0.0,
     "cached": 1,
     "busy": 1,
     "window_busy": 1,
     "window_capture_ms": 0.0,
