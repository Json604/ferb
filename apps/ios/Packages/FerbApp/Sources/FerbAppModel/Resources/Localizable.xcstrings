    "voice_text_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the microphone while you speak, and let go when you're done. Your words appear in the message box, so you can check them before you send. They're turned into words on this phone: nothing is recorded or kept, and your voice never goes to your Mac."
          }
        }
      }
    },
    "voice_text_service": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the microphone while you speak, and let go when you're done. Your words appear in the message box, so you can check them before you send. This iPhone turns speech into words with Apple's speech recognition, which may send the sound of your voice to Apple to do it. FERB records and keeps nothing, and your voice never goes to your Mac."
          }
        }
      }
    },
