{
  "version": 1,
  "about": "The words FERB's phone app puts on its home screen, chosen by what the phone knows about the moment. Each slot has rules; the highest-priority rule whose conditions all hold wins, and one of its lines is shown (the same one all day, a different one tomorrow). Edit this file and press Reload in the lab's Words scene. Placeholders: {sunset} {sunrise} {sunsetIn} {sunriseIn} {done} {waiting} {failed} {running} {day} {lastOpen} {awayDays} {time} {place} {temp} {rainAt} {season}.",
  "conditions": {
    "phase": "where the sun is: night, dawn, sunrise, morning, midday, afternoon, golden-hour, sunset, dusk",
    "hour": "local hour range, 'from-to', may wrap midnight (22-4)",
    "weekend": "true on Saturday and Sunday",
    "usual": "this hour against the owner's own opening hours: usual, earlier (earlier in the day than they ever open), later, rare",
    "firstToday": "the first open since 4 am",
    "awayHours": "hours since the app was last opened",
    "lateNights": "nights in the last 7 with an open between midnight and 4 am",
    "waiting": "questions FERB is waiting on",
    "done": "tasks finished since the last open",
    "failed": "tasks that could not finish since the last open",
    "running": "tasks running now",
    "link": "how the phone reaches the Mac: direct, own, shared, offline",
    "newPlace": "the phone's time zone changed since the last open",
    "firstRun": "the very first open, before pairing",
    "justPaired": "the first open after pairing",
    "sunsetIn": "minutes until sunset (only while the sun is up)",
    "sunriseIn": "minutes until sunrise (only before sunrise)",
    "numbers": "a number, or >=n, <=n, >n, <n, or a range a-b",
    "weather": "the weather now: clear, cloudy, overcast, rain, storm, snow, fog, wind",
    "temp": "the temperature now, in degrees",
    "rainIn": "minutes until the forecast says rain (only when it does)",
    "season": "spring, summer, monsoon (South Asia, June to September), autumn, winter; the south of the world the other way round",
    "moon": "full or new, on those nights only",
    "weekday": "1 Sunday ... 7 Saturday"
  },
