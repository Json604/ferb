#!/bin/sh
# tools/kb/run: runs kb.py or gate.py with Python 3.11+ (repo-kb). Usage: tools/kb/run kb|gate <args>
here=$(cd "$(dirname "$0")" && pwd)
tool=$1
case "$tool" in kb|gate) shift ;; *) echo "usage: tools/kb/run kb|gate <args>" >&2; exit 2 ;; esac
for py in "${KB_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3 python; do
  [ -n "$py" ] || continue
  command -v "$py" >/dev/null 2>&1 || continue
  if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    exec "$py" -I -B "$here/$tool.py" "$@"
  fi
done
if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --python '>=3.11' python -I -B "$here/$tool.py" "$@"
fi
echo "tools/kb/run: needs Python 3.11 or newer (or uv). Set KB_PYTHON to one." >&2
exit 1
