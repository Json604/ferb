# The site's settings (REL-436). Names only: the values are set in Vercel (Project → Settings → Environment
# Variables) and never committed. This file is env.example, not .env.example, because the commit gate refuses .env.*
# files. `vercel env pull .env.local` brings the values to this folder for scripts/send-update.mjs; .env.local is
# ignored by git.

# A long random string that signs the sign-in cookies, download links, the admin cookie and unsubscribe links, and
# keys the hashed IP addresses of the apps' rate limits. Changing it breaks the unsubscribe links in emails already sent.
AUTH_SECRET=

# The Google OAuth client (Google Cloud → Google Auth Platform → Clients), for the site and the apps. Its authorized
# redirect URIs: SITE_URL + /api/auth/callback (the download) and SITE_URL + /api/app/callback (the apps).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Neon Postgres database; Vercel sets it when the database is connected to the project.
DATABASE_URL=

# The Google account(s) that may open /api/admin, comma-separated.
ADMIN_EMAILS=

# The site's address, without a trailing slash: the sign-in's return address and the base of unsubscribe links.
SITE_URL=

# Resend's API key, the sender (an address on the domain verified in Resend) and where replies go: for
# scripts/send-update.mjs, and for the phone app's "Send me the link" (/api/app/send-link; 503 without them).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# PostHog analytics (REL-435): the project's public key (phc_…) and its ingestion address, https://us.i.posthog.com
# or https://eu.i.posthog.com. Read by the build (build.mjs); with neither set the pages load no script.
POSTHOG_KEY=
POSTHOG_HOST=

# Sign in with Apple for the apps (Apple Developer → Certificates, Identifiers & Profiles): the team id, the Services
# ID (its return URL: SITE_URL + /api/app/callback), the Sign in with Apple key's id and the key itself (the .p8
# file's whole PEM text). Apple sign-in answers 503 until all four are set.
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# The pairing assertion's signing key (a P-256 private key, PKCS#8 PEM) and its key id; FERB on the Mac pins the
# matching public key by this id. /api/app/assertion answers 503 until both are set.
APP_ASSERTION_KEY=
APP_ASSERTION_KID=

# The Android app's signing-certificate SHA-256 fingerprints (AA:BB:..., comma-separated), for
# /.well-known/assetlinks.json. Empty: the file is [].
ANDROID_CERT_SHA256=
