{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download/:file",
      "destination": "https://github.com/Json604/ferb-update/releases/latest/download/:file",
      "permanent": false
    },
    {
      "source": "/updates/appcast-:arch.xml",
      "destination": "https://github.com/Json604/ferb-update/releases/latest/download/appcast-:arch.xml",
      "permanent": false
    },
    {
      "source": "/updates/files/:tag/:file",
      "destination": "https://github.com/Json604/ferb-update/releases/download/:tag/:file",
      "permanent": false
    },
    {
      "source": "/updates/notes/:tag",
      "destination": "https://github.com/Json604/ferb-update/releases/tag/:tag",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/app/assetlinks"
    },
    {
      "source": "/app/callback",
      "destination": "/api/app/landing"
    }
  ]
}
