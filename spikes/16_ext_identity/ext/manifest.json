{
  "manifest_version": 3,
  "name": "FERB identity experiment (spike 16)",
  "version": "0.0.2",
  "description": "Experiment: FERB's identity driven through its original Chrome profile. Opens background tabs, reads them, closes them.",
  "key": "",
  "permissions": ["tabs", "scripting", "nativeMessaging"],
  "host_permissions": ["https://mail.google.com/*", "https://myaccount.google.com/*", "https://www.google.com/*",
                       "https://accounts.google.com/*"],
  "background": {"service_worker": "background.js"}
}
