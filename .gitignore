.env
.env.*
*.local.toml
*.local.json
.claude/settings.local.json
.ferb/
*.keychain
*.keychain-db
*.pem
*.key
*.p8
tests/.distill_usage.json

# Packaged app and disk image (scripts/build-app.sh, scripts/build-dmg.sh)
/build/

# Vercel CLI link for site/
.vercel/

# FERB's update signing key (L34 Phase G) belongs in the owner's Keychain and an offline backup, never here
sparkle_private*
*.sparkle-private*
