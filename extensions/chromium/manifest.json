{
  "manifest_version": 3,
  "name": "FERB",
  "version": "0.19.7",
  "description": "Lets the FERB assistant on your Mac read and operate the browser profiles you pair it with, for tasks you ask it to do.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "nativeMessaging",
    "alarms",
    "storage",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120"
}
