{
  "manifest_version": 3,
  "name": "FERB",
  "version": "0.13.0",
  "description": "FERB's hands in the browser: executes FERB daemon commands and reports state. No decisions here.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "nativeMessaging",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120"
}
