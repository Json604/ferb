<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FERB's background service (DMN-2): scripts/build-app.sh copies it to
     FERB.app/Contents/Library/LaunchAgents/com.ferb.daemon.plist (and sets FERB_APP_BUILD) before signing, and
     FERB.app registers it with SMAppService.agent(plistName:). Inside the signed app nothing can edit it, deleting the
     app removes it, and Login Items lists it under FERB. The agent (a native stub embedding the app's Python) accepts
     exactly `-m ferb.daemon` and always runs isolated (no working folder on sys.path); a fixed definition can't name
     the owner's home, so the daemon makes FERB's home its working folder and sends its output to FERB's logs itself
     (ferb/daemon/main.py service_streams). Restart after a crash, not after a clean exit. -->
<plist version="1.0"><dict>
<key>Label</key><string>com.ferb.daemon</string>
<key>BundleProgram</key><string>Contents/Helpers/FERB.app/Contents/MacOS/FERB</string>
<key>ProgramArguments</key><array><string>FERB</string><string>-m</string><string>ferb.daemon</string></array>
<key>EnvironmentVariables</key><dict><key>FERB_APP_BUILD</key><string>0</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>5</integer>
<key>ProcessType</key><string>Interactive</string>
<key>LimitLoadToSessionType</key><string>Aqua</string>
<key>AssociatedBundleIdentifiers</key><array><string>com.ferb.FERB</string></array>
</dict></plist>
