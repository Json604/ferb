flowchart TB
  O[Owner CLI or future client] --> RPC
  subgraph HARNESS[Harness — mechanics and observed facts]
    RPC[Authenticated local RPC]
    G[Gateway: validate, lock, own, execute]
    S[Disturbance sentinel: task and action observations]
    T[Stop and run tokens]
    DB[(Spans, journal, tasks, ledger, results)]
    E[Evidence pages and structured outcome export]
    R[Target recordings and cleanup facts]
    B[Browser bridge / native host / extension 0.13 protocol 8]
    N[Native AX / PID / explicit foreground route]
    F[Files and managed shell processes]
    G --> B & N & F & R
    G --> DB
    S --> DB
    E --> DB
    T --> G
    RPC --> E
  end
  subgraph APPROACH[Approach — agent judgment]
    C[Full request + token-budgeted context + intake receipts]
    P[Planner: meaning, source, identity, outcome conditions]
    W[Worker: choose tools and inspect results]
    Q[Question and recovery decisions]
    V[Checker: outcome and identity evidence]
    A[Final: unresolved conditions before facts]
    C --> P --> W
    W --> V --> A
    W --> Q --> W
    Q --> O
  end
  RPC --> C
  W --> G
  V --> G & E
  S -. observes .-> B & N & F & R
  A --> RPC
